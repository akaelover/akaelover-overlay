
EAPI=8

inherit cmake git-r3

DESCRIPTION="Neko Project II Kai PC-9801 emulator"
HOMEPAGE="https://github.com/piepacker/np2kai"

EGIT_REPO_URI="https://github.com/piepacker/np2kai.git"

LICENSE="MIT"
SLOT="0"
KEYWORDS=""
IUSE=""

DEPEND="
    media-libs/libsdl2
    media-libs/sdl2-mixer
    media-libs/sdl2-ttf
    dev-libs/openssl
    virtual/libusb:1
"
RDEPEND="${DEPEND}"
BDEPEND="
    dev-build/cmake
    dev-build/ninja
"

src_configure() {
    local mycmakeargs=(
        -DBUILD_SDL=ON
        -DBUILD_X=OFF
        -DUSE_SDL2=ON
        -DUSE_SDL_MIXER=ON
        -DUSE_SDL_TTF=ON
        -DBUILD_I286=OFF
    )

    cmake_src_configure
}

src_install() {
    cmake_src_install
    dodoc README.md
}

src_prepare() {
    default

    perl -pi -e '
        s/\bREG8(?=\s+dat\b)/UINT/g if /IOOUTCALL/;
        s/^static REG8 IOINPCALL/static UINT IOINPCALL/;
    ' cbus/boardx2.c cbus/boardspb.c
}
