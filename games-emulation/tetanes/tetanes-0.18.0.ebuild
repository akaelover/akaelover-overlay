RUST_MIN_VER="1.88.0"

inherit cargo desktop xdg

DESCRIPTION="Cross-platform NES emulator written in Rust using wgpu"
HOMEPAGE="https://lukeworks.tech/tetanes https://github.com/lukexor/tetanes"
SRC_URI="
	https://github.com/lukexor/tetanes/archive/refs/tags/${PN}-v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}-${PN}-v${PV}"

LICENSE="|| ( Apache-2.0 MIT )"
# Dependent crate licenses (aproximado; afínalo con pycargoebuild si quieres)
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD Boost-1.0 CC0-1.0 ISC
	MIT MPL-2.0 OFL-1.1 openssl UbuntuFontLicense-1.0 Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="
	dev-libs/wayland
	media-libs/alsa-lib
	media-libs/vulkan-loader
	virtual/libudev:=
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXi
	x11-libs/libXrandr
	x11-libs/libxkbcommon
"
DEPEND="${RDEPEND}"
BDEPEND="
	dev-build/cmake
	virtual/pkgconfig
"

QA_FLAGS_IGNORED="usr/bin/${PN}"

src_prepare() {
	default
	# Upstream compila con nightly, donde VecDeque::is_empty ya es const; con Rust
	# estable falla (E0015), así que has_events() deja de ser const
	sed -i 's/pub const fn has_events(/pub fn has_events(/' tetanes/src/nes/input.rs || die
}

src_compile() {
	# El perfil release de upstream hace strip; que lo gestione Portage
	export CARGO_PROFILE_RELEASE_STRIP=false
	cargo_src_compile --package tetanes --bin tetanes
}

src_install() {
	dobin "$(cargo_target_dir)/tetanes"
	dodoc README.md
	make_desktop_entry tetanes TetaNES "" "Game;Emulator;"
}
